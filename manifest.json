{
  "manifest_version": 3,
  "name": "Feed Auto-Advance",
  "version": "2.2",
  "description": "Automatically skips to the next short video on sites such as TikTok, Instagram Reels, YouTube Shorts, Facebook Reels, Snapchat Spotlight and others.",
  "permissions": ["storage", "scripting"],
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "browser_specific_settings": { "gecko": { "id": "feed-auto-advance@local", "data_collection_permissions": { "required": ["none"] } } },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Toggle auto-advance", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "96": "icons/icon-96.png", "128": "icons/icon-128.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": false },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.snapchat.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "optional_host_permissions": [
    "*://*.youtube.com/*", "*://*.tiktok.com/*", "*://*.instagram.com/*", "*://*.facebook.com/*", "*://*.snapchat.com/*", "*://*.redgifs.com/*"
  ]
}
